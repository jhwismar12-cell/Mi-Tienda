# --- Seguridad y Entorno (Backend) ---
# En la nube usar "produccion" para exigir ADMIN_PASSWORD propio (min. 8 caracteres)
ENTORNO="desarrollo"

# Clave secreta para firmar tokens de sesion (en Vercel definir una cadena aleatoria larga fija)
SECRET_KEY=""

# Credenciales del Administrador inicial al crear una nueva tienda (obligatorio en produccion)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_NOMBRE="Administrador"

# --- Datos Iniciales del Negocio (para nuevas tiendas) ---
TIENDA_SLUG="tienda-principal"
TIENDA_NOMBRE="Mi Tienda Familiar"
TIENDA_RUC="1792348590001"
TIENDA_DIRECCION="Quito, Ecuador"
TIENDA_TELEFONO="+593 99 123 4567"

# --- Persistencia en la Nube con Supabase (opcional en local, recomendado en Vercel) ---
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SYNC_SECRET=""

# --- Base de Datos y Red (Backend Local / VPS) ---
# Ruta persistente para SQLite local o VPS con disco (ej. /data/tienda.db en Railway/Render)
TIENDA_DB_PATH=""

# Origenes permitidos por CORS separados por coma (ej. https://tienda1.vercel.app)
ALLOWED_ORIGINS="*"

# Opcional: Clave de Gemini para lectura automatica de facturas con IA
GEMINI_API_KEY=""

# --- Frontend (Vite / React) ---
# URL del backend de esta tienda cuando el frontend se despliega separado
# En Vercel todo-en-uno (api/index.py + vercel.json) dejar vacio ""
VITE_API_URL=""
