# --- Seguridad y Entorno (Backend) ---
# En la nube usar "produccion" para exigir ADMIN_PASSWORD propio (min. 8 caracteres)
ENTORNO="desarrollo"

# Clave secreta para firmar tokens de sesion (si se deja vacia, se genera y guarda en SQLite automaticamente)
SECRET_KEY=""

# Credenciales del Administrador inicial al crear una nueva tienda (obligatorio en produccion)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_NOMBRE="Administrador"

# --- Datos Iniciales del Negocio (para nuevas tiendas) ---
TIENDA_NOMBRE="Mi Tienda Familiar"
TIENDA_RUC="1792348590001"
TIENDA_DIRECCION="Quito, Ecuador"
TIENDA_TELEFONO="+593 99 123 4567"

# --- Base de Datos y Red (Backend) ---
# Ruta persistente para la base de datos SQLite en la nube (ej. /data/tienda.db en Railway/Render)
TIENDA_DB_PATH=""

# Origenes permitidos por CORS separados por coma (ej. https://tienda1.vercel.app)
ALLOWED_ORIGINS="*"

# Opcional: Clave de Gemini para lectura automatica de facturas con IA
GEMINI_API_KEY=""

# --- Frontend (Vite / React) ---
# URL del backend de esta tienda cuando el frontend se despliega separado (ej. https://tienda1-api.onrender.com)
# Dejar vacio si el backend sirve directamente la carpeta dist/ o en desarrollo local con Vite proxy
VITE_API_URL=""
